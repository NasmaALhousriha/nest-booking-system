generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "sqlite"
  
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String?
  role      UserRole @default(PATIENT) 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientProfile Patient?
  doctorProfile  Doctor?  @relation("UserDoctorProfile") 

  @@map("users")
}

model Patient {
  id     Int     @id @default(autoincrement())
  phone  String?
  
  userId Int   @unique
  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookings Booking[]

  @@map("patients")
}

model Doctor {
  id        Int    @id @default(autoincrement())
  specialty String @default("General") 
  
  userId    Int    @unique
  user      User   @relation("UserDoctorProfile", fields: [userId], references: [id], onDelete: Cascade)

  bookings  Booking[]

  @@map("doctors")
}

model Booking {
  id              Int      @id @default(autoincrement())
  appointmentTime DateTime
  status          String   @default("PENDING")

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  doctorId  Int
  doctor    Doctor  @relation(fields: [doctorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId, appointmentTime])
  @@index([patientId, appointmentTime])
  @@map("bookings")
}